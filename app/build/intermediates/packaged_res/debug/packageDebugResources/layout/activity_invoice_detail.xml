<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/neon_black"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtInvNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invoice #"
        android:textColor="@color/neon_blue"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtInvCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer"
        android:textColor="#8FD8FF"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtInvTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total: SAR 0.00"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnTogglePaid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggle Paid Status"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSharePdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Share PDF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDeleteInvoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Invoice"
        android:backgroundTint="#FF5C8A" />
</LinearLayout>
