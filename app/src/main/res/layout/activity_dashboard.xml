<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/neon_black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#05080F"
        android:text="SAR Invoice"
        android:textColor="@color/neon_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Create"
                android:textColor="@color/neon_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnNewCustomer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Customer"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnNewInvoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Invoice"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnNewBill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bill"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnNewExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Expense"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/navInvoices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Invoices"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/navCustomers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Customers"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/navItems"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Items"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/navSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Settings"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#05080F"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outstanding"
                    android:textColor="#8FD8FF" />

                <TextView
                    android:id="@+id/txtOutstanding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAR 0.00"
                    android:textColor="@color/neon_blue"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#05080F"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paid"
                    android:textColor="#8FD8FF" />

                <TextView
                    android:id="@+id/txtPaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAR 0.00"
                    android:textColor="@color/neon_blue"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
